
    <h3>@BlogPost?.Title</h3>
    <p> @BlogPost?.Date.ToString("yyyy-MM-dd")</p>
    @foreach (var blogPostTag in BlogPost?.Tags)
    {
        <MudChip Color="Color.Info">@blogPostTag</MudChip>
    }
    <p>
        <strong>Excerpt:</strong> @BlogPost?.Excerpt
    </p>

@code {
    [Parameter]
    public BlogPost BlogPost { get; set; }


}
