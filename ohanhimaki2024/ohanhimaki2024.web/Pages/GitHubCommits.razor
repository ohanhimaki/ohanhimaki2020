  
    <div>
        @foreach (var commit in Commits.Take(ListLength))
        {
            <CommitComponent commit="@commit"/>
        }
        <div class="flex flex-col bg-gray-900 border-gray-800 border-t-2 cursor-pointer " @onclick="ShowMoreOrLess">
            <h3 class="m-auto ">
                @if (ListLength == 5)
                {
                    <span>Show more</span>
                }
                else
                {
                    <span>Show less</span>
                }
            </h3>
        </div>
    </div>
  
  

  @code {
    [Parameter]
    public List<GitHubCommit> Commits { get; set; }
    
    public int ListLength { get; set; } = 5;
    
    public void ShowMoreOrLess()
    {
        if (ListLength == 5)
        {
            ListLength = Commits.Count;
        }
        else
        {
            ListLength = 5;
        }
    }
}