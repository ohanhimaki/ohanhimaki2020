<style>
    .bannerbigimage {
        top: 60px;
        z-index: 40;
    }
    .bannerbigimage > .gatsby-image-wrapper {
        height: 400px;
        padding: 0.7rem 0 0.7rem 0;
    }

    .bannerbigimage {
        transition-duration: 1s;
        filter: brightness(40%) blur(12px) grayscale(100%);
    }
    .bannerbigimage:hover {
        transition-duration: 1s !important;
        filter: brightness(40%) blur(0px) !important;
    }

    .circleimg {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        position: relative;
    }

    .circleimg img {
        scale: 1.2;
        clip-path: circle(46% at 50% 50%);
    }

    .absolute {
        position: absolute;
        width: 100vw;
        top: 0;
        z-index: -1;
    }

    .text-center {
        text-align: center;
    }
</style>

<MudGrid Style="width: 100%; height: 400px" Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudItem xs="12" Style="height: 100%">
        <MudGrid Class="circleimg" Justify="Justify.Center">
            <MudItem md="4" Class="text-center" Style="padding-top: 50px; z-index: 999; ">
                <MudImage Style="width: 15vw" Src="images/mina.jpg"/>
                <MudText Style="padding-top: 25px" Typo="Typo.h4">
                    Olli Hanhimäki
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Dark">IT-Tradenomi</MudText>
                
            </MudItem>
        </MudGrid>
    </MudItem>
    <div class="absolute bannerbigimage" style="z-index: 998">
        <MudImage Style="width: 100vw" Src="images/bigimage.png"/>
    </div>
</MudGrid>

